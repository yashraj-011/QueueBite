# QueueBite Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Credentials (Server-only service role or secret key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Approved college email domain (Optional: if blank, allows all)
APPROVED_COLLEGE_DOMAIN=edu.in

# Collection grace period in minutes
COLLECTION_GRACE_PERIOD_MINUTES=30
